  "forensic_clusters": {
    "cluster_A_removal_demand_no_explanation": {
      "segments": [
        "0-4"
      ],
      "summary": "Stewardess opens with blunt removal order: 'Tiene que salir del avión, tiene que bajar'. No explanation offered. Passenger asks '¿Por qué?' three times. Stewardess remains silent through all three demands for an explanation — the delay (from second 2.87 to 12.8) is approximately 10 seconds of silence/refusal to answer."
    },
    "cluster_B_aggression_allegation_no_proof": {
      "segments": [
        "5-8"
      ],
      "summary": "Stewardess finally answers: 'Por qué fue agresivo'. First articulation of the aggression allegation. Passenger immediately demands proof: '¿dónde está la prueba?'. Stewardess ignores the demand and repeats the removal order. The allegation is stated as fact without evidence."
    },
    "cluster_C_passenger_refusal_and_conditional_compliance": {
      "segments": [
        "9-12"
      ],
      "summary": "Passenger refuses removal: 'Yo no voy a salir, simple, porque yo no tengo motivo.' Offers conditional compliance: will leave if shown proof. Stewardess radios for backup: 'el pasajero no se quiere mover'. Passenger informs he is recording. Security activated."
    },
    "cluster_D_touching_allegation_introduced": {
      "segments": [
        "13-20"
      ],
      "summary": "Stewardess shifts justification: references boarding-gate questions ('Usted empezó desde un comienzo a decir que el vuelo estaba tarde'). Passenger corrects: he asked questions, didn't make statements. Stewardess introduces second allegation: 'no tiene el derecho de tocar a mi compañero'. Passenger admits incidental touch, offers cultural explanation. Stewardess contradicts without detail: 'No fue así.' Passenger invokes cameras again."
    },
    "cluster_E_camera_agreement_and_immediate_reversal": {
      "segments": [
        "21-24"
      ],
      "summary": "Stewardess momentarily engages: 'Podemos pedir las cámaras del aeropuerto.' Passenger accepts conditionally: 'después de eso sí.' Stewardess immediately reverts to Portuguese: 'Vai ter que bajar.' The camera agreement — the only cooperative moment — is abandoned within 2 seconds. Passenger draws hard line: 'No, no voy, punto' and warns forced removal will strengthen the legal case."
    },
    "cluster_F_security_escalation": {
      "segments": [
        "25"
      ],
      "summary": "Stewardess calls for security: 'Llamen a la ventas. No hay caso.' Recording ends. The removal process moves from verbal demand to physical enforcement."
    }
  },
