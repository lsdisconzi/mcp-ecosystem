    {
      "index": 50,
      "speaker": "DGAC_higher_official_Nicolas",
      "start": 282.185,
      "end": 291.105,
      "duration": 8.92,
      "text": "Porta Llamas, Salón Central, en la puerta 27 de la R1, en el lugar de carga celular, dejando el bolsito listo.",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
