      "speaker": "passenger",
      "start": 642.185,
      "end": 652.185,
      "duration": 10.0,
      "text": "¿Puedo hacerle una pregunta? Sí ¿Cuál es el motivo, la responsabilidad de la DGAC?",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
