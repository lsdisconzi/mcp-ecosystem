    },
    {
      "index": 25,
      "speaker": "passenger",
      "start": 138.8,
      "end": 145.5,
      "duration": 6.7,
      "text": "No, por nada. por nada.\nYo stoy cansado de explicaciones ridículas, hidrúxulas que están siendo usadas contra...",
