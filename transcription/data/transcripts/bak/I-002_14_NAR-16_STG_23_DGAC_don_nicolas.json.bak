    {
      "index": 4,
      "speaker": "passenger",
      "start": 9.5,
      "end": 15.0,
      "duration": 5.5,
      "text": "¡Ah, ya pero, ya te impliqué! No, yo quiero por escrito.\n¿Por qué hicieron lo que me hicieron?",
