  "forensic_clusters": {
    "cluster_A_captain_authority": {
      "segments": [
        "12-29"
      ],
      "summary": "Don Nicolas explains the Código Aeronáutico: the captain has absolute authority, the airline decides who flies, and DGAC merely assists. The remedy for wrongful removal is exclusively post-hoc civil litigation.",
      "reasoning": "The framework is procedurally correct but provides no real-time protection. The passenger loses his status and must disembark regardless of the truth of the accusation.",
      "provisions_engaged": [
        "Código Aeronáutico Chileno",
        "CACH Art. 133",
        "CONST Art. 19 N°3"
      ]
    },
    "cluster_B_pasajero_disruptivo": {
      "segments": [
        "24-29"
      ],
      "summary": "Don Nicolas explains that refusing to disembark converts the passenger into a 'pasajero insubordinado o disruptivo' — a statutory classification triggered by non-compliance, regardless of the validity of the underlying accusation. He states: 'No importa para este efecto el motivo.'",
      "reasoning": "This motive-blind mechanism converts a false accusation into a self-fulfilling prophecy: protest → insubordinación → disruptivo label, all without verifying the original accusation.",
      "provisions_engaged": [
        "Código Aeronáutico Chileno",
        "CONST Art. 19 N°2",
        "ACHR Art. 25",
        "Ley 20.609"
      ],
      "violation_linkage": "F-019 (disruptivo label), F-014 (causal inversion)"
    },
    "cluster_C_discrimination_question": {
      "segments": [
        "65-67"
      ],
      "summary": "Leandro asks directly: 'Esto puede ser simplesmente descriminacion?!' Don Nicolas does not deny the possibility, redirecting to the post-hoc remedy of filing a complaint against the airline.",
      "reasoning": "The first time 'discriminación' is spoken on tape. Don Nicolas's response effectively acknowledges that the system cannot prevent discrimination in real time.",
      "provisions_engaged": [
        "Ley 20.609",
        "CONST Art. 19 N°2",
        "LPDC Art. 3(e)"
      ],
      "violation_linkage": "pending F-006 (discrimination-on-nationality)"
    },
    "cluster_D_atados_de_mano": {
      "segments": [
        "86",
        "100",
        "104-105"
      ],
      "summary": "CRITICAL: Don Nicolas admits DGAC is 'atados de mano' — hands tied. They cannot ask why the airline wants a passenger removed, must comply when the airline invokes the law, and the only check on bad-faith invocations is the court system.",
      "reasoning": "The operational gap is stark: no real-time verification. The passenger asks who ensures the airline isn't using the law in bad faith; Don Nicolas answers: 'Para eso existen los tribunales' — only the courts, post-hoc.",
      "provisions_engaged": [
        "Código Aeronáutico Chileno",
        "CONST Art. 19 N°2",
        "ACHR Art. 25"
      ],
      "violation_linkage": "Structural evidence confirming the legal architecture permits what occurred."
    },
    "cluster_E_law_reform_advocacy": {
      "segments": [
        "96-97"
      ],
      "summary": "REMARKABLE: Don Nicolas reveals internal discussion about the case and advocates for changing the law to require airlines to show some basis for removal.",
      "reasoning": "A senior DGAC official, on tape, expresses the view that the current legal framework is inadequate — a powerful contextual admission.",
      "provisions_engaged": [],
