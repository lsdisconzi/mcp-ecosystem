    },
    {
      "index": 31,
      "speaker": "dgac_edgardo_ortiz",
      "start": 167.0,
      "end": 170.0,
      "duration": 3.0,
      "text": " ¿Cómo fiscalizamos que no cumpla?",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
      "index": 32,
      "speaker": "passenger",
      "start": 170.0,
      "end": 175.0,
      "duration": 5.0,
      "text": " Tú me diga, yo no sé, tú me diga a mí, yo no sé, no trabajo acá, tú trabaja acá.",
