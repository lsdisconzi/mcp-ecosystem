    },
    {
      "index": 24,
      "speaker": "dgac_edgardo_ortiz",
      "start": 135.0,
      "end": 138.8,
      "duration": 3.8,
      "text": "Usted no deja terminar lo que uno habla porque usted sabe que le estoy explicando lo que quiere y no quiere escuchar lo que uno está explicando. ",
      "reviewed": true,
      "correction_note": "att here. The reverse tactic, when they accuse you of doing exactly what they are doing.",
