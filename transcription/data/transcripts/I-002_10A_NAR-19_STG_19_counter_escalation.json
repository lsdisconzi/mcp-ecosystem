    },
    {
      "index": 3,
      "speaker": "passenger",
      "start": 23.723468750000002,
      "end": 29.106593750000002,
      "duration": 5.383,
      "text": " Yo escuché, no sé si el jefe o quien era de la PDI, sino para...",
