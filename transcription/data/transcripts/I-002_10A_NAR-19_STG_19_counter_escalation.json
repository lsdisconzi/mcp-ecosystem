    {
      "index": 5,
      "speaker": "passenger",
      "start": 37.79721875,
      "end": 41.32,
      "duration": 3.523,
      "text": " Pero eso por escrito nadie quiere me dar.\n Mira.",
      "reviewed": true,
      "correction_note": "",
