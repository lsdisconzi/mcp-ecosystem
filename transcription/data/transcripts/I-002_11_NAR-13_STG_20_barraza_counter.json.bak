    },
    {
      "index": 38,
      "speaker": "passenger",
      "start": 155.0,
      "end": 159.2,
      "duration": 4.2,
      "text": "Mira! yo no tengo que colaborar se usted estan me difamando.. dos mentiras.\n\n",
