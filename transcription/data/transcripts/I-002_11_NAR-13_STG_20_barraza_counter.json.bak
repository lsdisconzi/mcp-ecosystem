      "correction_note": "",
      "backchannel_events": ""
    },
    {
      "index": 57,
      "speaker": "passenger",
      "start": 217.73721875,
      "end": 218.63159375,
      "duration": 0.894,
      "text": " ¿Y la PDI?",
