      "start": 159.2,
      "end": 162.14221875,
      "duration": 2.942,
      "text": "Yo no te voy a colaborar porque tú no me hiciste colaborar. Nadie te va a colaborar.",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
      "index": 40,
      "speaker": "passenger",
      "start": 162.31096875,
      "end": 166.0,
      "duration": 3.689,
      "text": "Pero por que voy a colaborar con una mentira, Una difamación",
