      "start": 207.49409375,
      "end": 209.4,
      "duration": 1.906,
      "text": " ¿Ya? ¿Entonces dónde?",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
      "index": 54,
      "speaker": "passenger",
      "start": 211.63284375,
      "end": 212.8,
      "duration": 1.167,
      "text": "Responde!",
      "reviewed": true,
      "correction_note": "",
