      "start": 194.6,
      "end": 195.97721875,
      "duration": 1.377,
      "text": "Ta.  ¿Entonces por qué?",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
      "index": 48,
      "speaker": "passenger",
      "start": 195.97721875,
      "end": 197.61409375,
      "duration": 1.637,
      "text": " ¿Por qué me sacaron? ",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
      "index": 49,
      "speaker": "airline_security_official",
      "start": 197.61409375,
      "end": 199.4,
      "duration": 1.786,
      "text": "Porque ingresaste sin autorización.",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
      "index": 50,
      "speaker": "passenger",
      "start": 199.5,
      "end": 201.4,
      "duration": 1.9,
      "text": " ¿Y cómo que tú compruebas eso?",
