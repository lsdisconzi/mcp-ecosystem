    },
    {
      "index": 28,
      "speaker": "passenger",
      "start": 127.5,
      "end": 135.8,
      "duration": 8.3,
      "text": "¿Entiendes que estás complicándote cada vez más?\nTú estás se complicando. Tú persona ahora. Ya no es más la Latam. Tú persona estás se complicando.",
