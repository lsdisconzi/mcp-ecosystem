    },
    {
      "index": 51,
      "speaker": "airline_security_official",
      "start": 201.18284375,
      "end": 202.0,
      "duration": 0.817,
      "text": " Porque yo lo vi en cámara. ",
      "reviewed": true,
      "correction_note": "",
      "backchannel_events": ""
    },
    {
      "index": 52,
      "speaker": "passenger",
      "start": 202.3,
      "end": 207.49409375,
      "duration": 5.194,
      "text": "Entonces, ¿tú? Tiene que comprobar eso por escrito y asignar en barro si fue tú que vio.",
