{
  "input_root": "/Users/dev/_sell/mcp-ecosystem/ocr/images",
  "output_root": "./results",
  "working_dir": "image_processing_workspace",
  "supported_extensions": [
    ".heic",
    ".png",
    ".jpg",
    ".jpeg",
    ".bmp",
    ".tiff",
    ".tif"
  ],
  "llm_provider": "deepseek",
  "llm_model": "deepseek-v4-flash",
  "ollama_model": "llama3.1",
  "ollama_base_url": "http://localhost:11436/v1",
  "llm_temperature": 0.1,
  "llm_max_tokens": 8192,
  "ocr_language": "por+eng",
  "csv_encoding": "utf-8-sig",
  "dry_run": false,
  "log_level": "INFO",
  "max_ocr_chars": 3000,
  "knowledge_base_file": "knowledge_base.json",
  "file_cache_file": "file_cache.json",
  "enable_learning": true,
  "enable_cache": true,
  "force_reprocess": false,
  "enable_preprocessing": true,
  "enable_refinement": true,
  "min_ocr_confidence_trusted": 70.0,
  "min_ocr_confidence_flag": 45.0,
  "fuzzy_match_threshold": 0.84,
  "correction_min_occurrences": 2,
  "upscale_target_width": 1800
}