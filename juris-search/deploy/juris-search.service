[Unit]
Description=Juris Search Backend (FastAPI multi-court jurisprudence search API)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/awareness/services/juris-search
ExecStart=/awareness/services/juris-search/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=juris-search
Environment="PORT=8000"
EnvironmentFile=-/awareness/services/juris-search/.env

[Install]
WantedBy=multi-user.target
