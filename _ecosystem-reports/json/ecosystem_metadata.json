      {
        "name": "transcriber",
        "role": "Transcribes audio to text with speaker diarization",
        "tools": [
          "whisper",
          "transcribe_audio",
          "transcribe_audio_async"
        ]
      },
      {
        "name": "diarizer",
        "role": "Identifies speakers in audio transcriptions",
        "tools": [
          "diarization",
          "speaker_id"
        ]
      },
      {
        "name": "translator",
        "role": "Translates and analyzes transcribed content",
        "tools": [
          "translation",
          "sentiment"
        ]
      }
    ],
    "human_interfaces": [
      {
        "type": "Pinocchio Transcription UI",
        "url": "http://127.0.0.1:8049/pinocchio"
