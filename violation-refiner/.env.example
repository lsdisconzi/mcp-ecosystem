# ViolationRefiner — environment template
#
# Copy to .env and fill in what you need:   cp .env.example .env
# .env is git-ignored; .env.example is whitelisted on purpose.
#
# Everything here has a working default EXCEPT the credentials you opt into.
# The core pipeline (layers, validation, packaging) runs with NO .env at all.
# Only these two features need configuration:
#   * LLM enrichment  -> LLM_* (or a provider-specific *_API_KEY)
#   * Qdrant / Neo4j  -> QDRANT_* / NEO4J_*
#
# `Settings.from_env()` reads the 31 variables in section 1.
# `mcp_server.main()` additionally reads the 3 transport variables in section 2.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Settings.from_env() — 31 variables
# ─────────────────────────────────────────────────────────────────────────────

# ---- LLM (generic — applies to any provider) -------------------------------
# LLM_PROVIDER: openrouter | anthropic | deepseek | openai | ollama
# If unset, the provider is inferred from LLM_BASE_URL and/or which API key is
# present. Setting the provider-specific key below is usually enough.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8000
LLM_TOKEN_BUDGET=250000
LLM_TIMEOUT_SECONDS=90.0

# ---- Provider-specific credentials (set the one you use) -------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Ollama (local LLM + local embeddings; no API key needed) --------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_API_KEY=

# ---- Authority verification governance -------------------------------------
# Minimum multiplier for the authorities composite in derive_confidence().
# 0.85 means "authorities can lift confidence by at most 15%".
AUTHORITY_VERIFICATION_FLOOR=0.85

# ---- Qdrant (vector index) -------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
# Collections are namespaced by this prefix, per embedder.
QDRANT_COLLECTION_PREFIX=violationrefiner_v1

# ---- Neo4j (knowledge graph) ----------------------------------------------
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=agent.violation.refiner
# Optional second endpoint (e.g. a local instance) for local-only tooling.
NEO4J_LOCAL_URI=
NEO4J_LOCAL_USER=
NEO4J_LOCAL_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# 2. MCP server transport — read by mcp_server.main()
# ─────────────────────────────────────────────────────────────────────────────
# MCP_TRANSPORT: stdio | sse | streamable-http   (default: stdio)
# start.sh defaults this to streamable-http so the /health endpoint exists.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8124
