  "key_files": [
    {"path": "violation_pack/models.py", "lines": 370, "role": "All Pydantic schemas"},
    {"path": "violation_pack/enrich.py", "lines": 990, "role": "LLM-driven enrichment orchestration"},
    {"path": "violation_pack/mcp_server.py", "lines": 769, "role": "MCP server with 30 tools"},
