[Unit]
Description=Ops Dashboard — central service monitor
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/Users/leandrodisconzi/repos/mcp-ecosystem/ops
ExecStart=/Users/leandrodisconzi/repos/mcp-ecosystem/ops/.venv/bin/python3 /Users/leandrodisconzi/repos/mcp-ecosystem/ops/app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ops-dashboard
Environment="PORT=9000"
Environment="OPS_DASHBOARD_PORT=9000"
Environment="OPS_PROJECT_ROOT=/Users/leandrodisconzi/repos/mcp-ecosystem"

[Install]
WantedBy=multi-user.target
