[Unit]
Description=Awareness-AI Ops Dashboard
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/Users/leandrodisconzi/repos/mcp-ecosystem/ops
EnvironmentFile=/etc/ops-dashboard.env
Environment="OPS_PROJECT_ROOT=/Users/leandrodisconzi/repos/mcp-ecosystem"
ExecStart=/Users/leandrodisconzi/repos/mcp-ecosystem/ops/.venv/bin/python3 /Users/leandrodisconzi/repos/mcp-ecosystem/ops/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
